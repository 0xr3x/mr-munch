{
  "name": "mrmunch",
  "version": "0.1.0",
  "private": true,
  "description": "Mr Munch monorepo — recommend API + SaintMrMunchbot (Telegram)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "typecheck": "tsc --noEmit",
    "telegram:setup": "curl -sS -X POST \"${MRMUNCH_PUBLIC_URL:-https://mrmunch.vercel.app}/api/telegram/setup\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vercel/node": "^5.0.2",
    "typescript": "^5.7.2",
    "vercel": "^39.3.0"
  }
}
