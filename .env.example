# Runtime mode: mock | live
MRMUNCH_MODE=mock

# MongoDB Atlas — use the cluster connection string (Drivers), NOT an Atlas Admin API key
MONGODB_URI=mongodb+srv://<dbUser>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mrmunch
# Optional: protect POST /api/atlas/bootstrap
BOOTSTRAP_SECRET=

# Voyage AI: embeddings/rerank run inside Atlas (autoEmbed + $rerank).
# Separate Voyage API key only needed if you call Voyage outside Atlas.
VOYAGE_API_KEY=

# Google Maps Platform (places / geocoding)
GOOGLE_MAPS_API_KEY=

# OpenStreetMap Overpass — keep User-Agent simple (parenthetical UAs can 406)
OSM_USER_AGENT=MrMunch/0.1

# OpenAI (menu OCR / vision for menu photos & specials boards)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Website reader for menus (Jina Reader bypasses many bot walls)
WEB_READER_BASE=https://r.jina.ai/

# Voyage AI (reranking — used later with Atlas hybrid/vector search)
VOYAGE_API_KEY=
